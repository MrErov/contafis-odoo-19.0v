                        table th { background-color: #f2f2f2; text-align: center; }
                        td.label { text-align: left; font-weight: bold; background-color: #fafafa; }
                        td.total { font-weight: bold; background-color: #e8e8e8; }
                        h2 { margin-bottom: 4px; text-align: center; }
                        h3 { margin: 8px 0 4px 0; text-align: center; }
                        .header-info { font-size: 10px; margin-bottom: 8px; }
                        .header-info table { border: none; }
