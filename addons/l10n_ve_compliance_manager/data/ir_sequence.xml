<odoo>
    <data noupdate="1">
        <record id="sequence_l10n_ve_obligation" model="ir.sequence">
            <field name="name">Obligación de Cumplimiento</field>
            <field name="code">l10n.ve.obligation</field>
            <field name="prefix">OBL-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <record id="sequence_l10n_retention" model="ir.sequence">
            <field name="name">Retención</field>
            <field name="code">l10n.retention</field>
            <field name="prefix">RET-%(year)s-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>