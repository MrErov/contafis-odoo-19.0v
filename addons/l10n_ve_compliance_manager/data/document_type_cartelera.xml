        <!--
        Tipos de documento del "Excel de Control de Cartelera Fiscal" usado por
        los contadores venezolanos (36 documentos, columnas E..AN del Excel).

        Orden EXACTO de las columnas del Excel (fila 3 de encabezados):
          C01-C04  Extras (institución municipal / Alcaldía)
          C05-C12  SENIAT
          C13-C17  IVSS
          C18-C19  INCES
          C20-C23  APORTE FAOV/BANAVIH
          C24-C29  MINTRA
          C30-C36  ALCALDÍA

        El campo `code` (C01..C36) es la clave estable de mapeo: varios nombres
        se repiten entre instituciones ("Planilla de Inscripción", "Último
        soporte de Pago") y solo institution_id los diferencia.
        -->

        <!-- ==================== Extras → Alcaldía (municipal) ==================== -->

        <record id="document_type_cartelera_01" model="l10n.ve.document.type">
            <field name="name">Publicación Mercantil</field>
            <field name="code">C01</field>
            <field name="institution_id" ref="institution_demo_municipality"/>
            <field name="validity_days">365</field>
            <field name="renewal_alert_days">30</field>
            <field name="required_for">company</field>
            <field name="alert_channel">email</field>
        </record>

