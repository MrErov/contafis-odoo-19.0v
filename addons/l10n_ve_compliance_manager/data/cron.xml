<odoo>
    <data>
        <record id="cron_l10n_ve_compliance_alerts" model="ir.cron">
            <field name="name">Cumplimiento VE: Generar alertas de cumplimiento</field>
            <field name="model_id" ref="model_l10n_ve_obligation"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_compliance_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="cron_l10n_ve_cartelera_snapshot" model="ir.cron">
            <field name="name">Cumplimiento VE: Generar snapshot cartelera mensual</field>
            <field name="model_id" ref="model_l10n_ve_cartelera_status"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_monthly_snapshot()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
