<odoo>
    <record id="view_l10n_ve_alert_list" model="ir.ui.view">
        <field name="name">l10n.ve.alert.list</field>
        <field name="model">l10n.ve.alert</field>
        <field name="arch" type="xml">
            <list string="Alertas" multi_edit="1">
                <field name="name"/>
                <field name="client_id"/>
                <field name="alert_type"/>
                <field name="date"/>
                <field name="channel" optional="hide"/>
                <field name="state"/>
                <field name="sent_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_alert_form" model="ir.ui.view">
        <field name="name">l10n.ve.alert.form</field>
        <field name="model">l10n.ve.alert</field>
        <field name="arch" type="xml">
            <form string="Alerta">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,sent,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Título de la alerta"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="obligation_id"/>
                            <field name="document_id"/>
                            <field name="alert_type"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="channel"/>
                            <field name="sent_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Destinatarios">
                        <field name="recipient_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Mensaje">
                        <field name="message" nolabel="1" placeholder="Mensaje de la alerta..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ve_alert_search" model="ir.ui.view">
        <field name="name">l10n.ve.alert.search</field>
        <field name="model">l10n.ve.alert</field>
        <field name="arch" type="xml">
            <search string="Alertas">
                <field name="name"/>
                <field name="client_id"/>
                <field name="obligation_id"/>
                <field name="document_id"/>
                <field name="alert_type"/>
                <field name="state"/>
                <filter string="Pendientes" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Enviadas" name="filter_sent" domain="[('state', '=', 'sent')]"/>
                <filter string="Resueltas" name="filter_done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Agrupar por estado" name="groupby_state" context="{'group_by': 'state'}"/>
                <filter string="Agrupar por tipo" name="groupby_type" context="{'group_by': 'alert_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ve_alert" model="ir.actions.act_window">
        <field name="name">Alertas</field>
        <field name="res_model">l10n.ve.alert</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
