<odoo>
    <record id="view_l10n_ve_document_list" model="ir.ui.view">
        <field name="name">l10n.ve.document.list</field>
        <field name="model">l10n.ve.document</field>
        <field name="arch" type="xml">
            <list string="Documentos" multi_edit="1">
                <field name="client_id"/>
                <field name="document_type_id"/>
                <field name="number"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="state"/>
                <field name="last_alert_date" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_ve_document_form" model="ir.ui.view">
        <field name="name">l10n.ve.document.form</field>
        <field name="model">l10n.ve.document</field>
        <field name="arch" type="xml">
            <form string="Documento">
                <sheet>
                    <group>
                        <group>
                            <field name="client_id"/>
                            <field name="document_type_id"/>
                            <field name="number"/>
                            <field name="obligation_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="state"/>
                            <field name="last_alert_date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Archivo adjunto">
                        <field name="attachment" widget="binary"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1" placeholder="Notas del documento..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_ve_document_search" model="ir.ui.view">
        <field name="name">l10n.ve.document.search</field>
        <field name="model">l10n.ve.document</field>
        <field name="arch" type="xml">
            <search string="Documentos">
                <field name="client_id"/>
                <field name="document_type_id"/>
                <field name="number"/>
                <field name="state"/>
                <filter string="Válidos" name="filter_valid" domain="[('state', '=', 'valid')]"/>
                <filter string="Expirados" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Pendientes" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Rechazados" name="filter_rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Agrupar por cliente" name="groupby_client" context="{'group_by': 'client_id'}"/>
                <filter string="Agrupar por tipo" name="groupby_type" context="{'group_by': 'document_type_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_l10n_ve_document" model="ir.actions.act_window">
        <field name="name">Documentos</field>
        <field name="res_model">l10n.ve.document</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>