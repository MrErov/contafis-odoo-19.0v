<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View - Main Import Wizard -->
        <record id="view_l10n_ve_import_wizard_form" model="ir.ui.view">
            <field name="name">l10n.ve.import.wizard.form</field>
            <field name="model">l10n.ve.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Importación desde Excel">
                    <header>
                        <button name="action_download_template" string="Descargar Plantilla"
                                type="object" class="btn-secondary"
                                invisible="state != 'draft'"/>
                        <button name="action_load_file" string="Cargar y Mapear"
                                type="object" class="btn-primary"
                                invisible="state != 'draft'"/>
                        <button name="action_preview" string="Generar Vista Previa"
                                type="object" class="btn-primary"
                                invisible="state != 'mapping'"/>
                        <button name="action_validate" string="Validar"
                                type="object" class="btn-primary"
                                invisible="state != 'preview'"/>
                        <button name="action_import" string="Importar"
                                type="object" class="btn-primary"
                                invisible="state != 'validating'"/>
                        <button name="action_reset" string="Reiniciar"
                                type="object" class="btn-secondary"
                                invisible="state == 'draft'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_download_template" class="oe_stat_button"
                                    icon="fa-download" type="object"
                                    invisible="state != 'draft'">
                                <field name="filename" widget="statinfo"
                                       string="Plantilla"/>
                            </button>
                        </div>

                        <group string="Configuración de Importación">
                            <group>
                                <field name="import_type" required="true"/>
                                <field name="company_id" required="true"
                                       options="{'no_create': True, 'no_open': True}"/>
                                <field name="mode"/>
                            </group>
                            <group>
                                <field name="preview_limit"/>
                            </group>
                        </group>

                        <notebook>
                            <!-- PASO 1: Subir Archivo -->
                            <page string="1. Subir Archivo" name="page_upload"
                                  invisible="state != 'draft'">
                                <group>
                                    <field name="file" filename="filename"
                                           widget="attachment"
                                           required="true"
                                           help="Seleccione un archivo .xlsx"/>
                                    <field name="filename" invisible="1"/>
                                    <field name="cartelera_year"
                                           invisible="import_type != 'cartelera'"/>
                                    <field name="cartelera_month"
                                           invisible="import_type != 'cartelera'"/>
                                    <field name="period_month"
                                           invisible="import_type not in ('vat_book_purchase', 'vat_book_sale')"/>
                                    <field name="sheet_name"
                                           invisible="import_type not in ('vat_book_purchase', 'vat_book_sale')"
                                           readonly="1"/>
                                </group>
                                <div class="alert alert-info mt-3" role="status">
                                    <strong>Instrucciones:</strong>
                                    <ul>
                                        <li>Descargue la plantilla correspondiente al tipo de importación.</li>
                                        <li>Complete los datos en Excel respetando los encabezados.</li>
                                        <li>Suba el archivo aquí y pulse "Cargar y Mapear".</li>
                                    </ul>
                                </div>
                            </page>

                            <!-- PASO 2: Mapeo -->
                            <page string="2. Mapear Columnas" name="page_mapping"
                                  invisible="state != 'mapping'">
                                <field name="mapping_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="column_letter" readonly="1"/>
                                        <field name="col_name" readonly="1"
                                               string="Columna en Excel"/>
                                        <field name="field_name"
                                               string="Campo Odoo"/>
                                        <field name="field_type" readonly="1"/>
                                        <field name="required" readonly="1"/>
                                        <field name="relation_model"
                                               invisible="field_type != 'many2one'"/>
                                        <field name="default_value"
                                               invisible="field_type not in ('char', 'text', 'selection', 'boolean', 'integer', 'float')"/>
                                    </list>
                                </field>
                                <div class="alert alert-warning mt-3" role="alert" invisible="mapping_ids">
                                    No hay mapeos definidos. Pulse "Cargar y Mapear" para auto-detectar.
                                </div>
                            </page>

                            <!-- PASO 3: Preview -->
                            <page string="3. Vista Previa" name="page_preview"
                                  invisible="state != 'preview'">
                                <div class="alert alert-info" role="status">
                                    <strong>Vista previa limitada a
                                    <field name="preview_limit" class="oe_inline"/> filas.</strong>
                                </div>
                                <div class="alert alert-warning mt-2" role="alert"
                                     invisible="not cartelera_unmatched_headers">
                                    <i class="fa fa-exclamation-triangle"/>
                                    <strong>Headers no reconocidos:</strong>
                                    <span class="ms-2"><field name="cartelera_unmatched_headers" readonly="1"/></span>
                                    <br/>
                                    <small>Se ignoraron <span class="text-danger">N</span> columnas que no coinciden con tipos de documento. Verifique el Excel.</small>
                                </div>
                                <div class="mb-3">
                                    <button name="action_validate_syntax" string="Validar Sintaxis"
                                            type="object" class="btn-primary"/>
                                </div>
                                <field name="line_ids" nolabel="1"
                                       domain="[('state', 'in', ['draft', 'validated', 'error'])]">
                                    <list readonly="1" decoration-danger="state == 'error'"
                                          decoration-muted="state == 'skipped'">
                                        <field name="row_index" string="#"/>
                                        <field name="state"
                                               widget="badge"
                                               decoration-success="state == 'validated'"
                                               decoration-danger="state == 'error'"
                                               decoration-muted="state == 'skipped'"/>
                                        <field name="data" widget="json"
                                               string="Datos"/>
                                        <field name="error_msg" invisible="state != 'error'"/>
                                    </list>
                                </field>
<div class="alert alert-warning mt-3" role="alert"
                                      invisible="not preview_exceeded">
                                     <i class="fa fa-exclamation-triangle"/>
                                     El archivo tiene más filas que el límite de vista previa.
                                     Solo se muestran las primeras
                                     <field name="preview_limit" class="oe_inline"/> filas.
                                </div>
                            </page>

                            <!-- PASO 4: Validación -->
                            <page string="4. Validar" name="page_validate"
                                  invisible="state != 'validating'">
                                <field name="line_ids" nolabel="1"
                                       domain="[('state', 'in', ['draft', 'validated', 'error'])]">
                                    <list readonly="1" decoration-danger="state == 'error'">
                                        <field name="row_index" string="#"/>
                                        <field name="state"
                                               widget="badge"
                                               decoration-success="state == 'validated'"
                                               decoration-danger="state == 'error'"
                                               decoration-muted="state == 'skipped'"/>
                                        <field name="data" widget="json"/>
                                        <field name="error_msg" invisible="state != 'error'"/>
                                    </list>
                                </field>
                            </page>

                            <!-- PASO 5: Importar -->
                            <page string="5. Importar" name="page_import"
                                  invisible="state != 'done'">
                                <div class="alert alert-success" role="status">
                                    <h4>Importación Completada</h4>
                                    <p>La importación se ha procesado correctamente.</p>
                                </div>
                                <field name="line_ids" nolabel="1">
                                    <list readonly="1"
                                          decoration-success="state in ('imported', 'updated')"
                                          decoration-danger="state == 'error'"
                                          decoration-muted="state == 'skipped'">
                                        <field name="row_index" string="#"/>
                                        <field name="state"
                                               widget="badge"
                                               decoration-success="state in ('imported', 'updated')"
                                               decoration-danger="state == 'error'"
                                               decoration-muted="state == 'skipped'"/>
                                        <field name="record_name" string="Registro"/>
                                        <field name="model_name" string="Modelo"/>
                                        <field name="error_msg" invisible="state != 'error'"/>
                                    </list>
                                </field>
                                <div class="mt-3">
                                    <field name="attachment_id" widget="attachment"
                                           readonly="1" string="Log de Importación"/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Wizard Action -->
        <record id="action_l10n_ve_import_wizard" model="ir.actions.act_window">
            <field name="name">Importar desde Excel</field>
            <field name="res_model">l10n.ve.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'default_import_type': 'obligation'}</field>
        </record>

        <!-- Mapping Tree View (embedded in wizard) -->
        <record id="view_l10n_ve_import_mapping_tree" model="ir.ui.view">
            <field name="name">l10n.ve.import.mapping.tree</field>
            <field name="model">l10n.ve.import.mapping</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="column_letter" readonly="1"/>
                    <field name="col_name" readonly="1" string="Columna Excel"/>
                    <field name="field_name" string="Campo Odoo"/>
                    <field name="field_type" readonly="1"/>
                    <field name="required" readonly="1"/>
                    <field name="relation_model" invisible="field_type != 'many2one'"/>
                    <field name="default_value"
                           invisible="field_type not in ('char', 'text', 'selection', 'boolean', 'integer', 'float')"/>
                </list>
            </field>
        </record>

        <!-- Line Tree View -->
        <record id="view_l10n_ve_import_line_tree" model="ir.ui.view">
            <field name="name">l10n.ve.import.line.tree</field>
            <field name="model">l10n.ve.import.line</field>
            <field name="arch" type="xml">
                <list>
                    <field name="row_index" string="#"/>
                    <field name="state"
                           widget="badge"
                           decoration-success="state in ('validated', 'imported', 'updated')"
                           decoration-danger="state == 'error'"
                           decoration-muted="state == 'skipped'"/>
                    <field name="data" widget="json"/>
                    <field name="error_msg" invisible="state != 'error'"/>
                    <field name="record_name" string="Registro"/>
                    <field name="model_name" string="Modelo"/>
                </list>
            </field>
        </record>

        <!-- Log Tree View -->
        <record id="view_l10n_ve_import_log_tree" model="ir.ui.view">
            <field name="name">l10n.ve.import.log.tree</field>
            <field name="model">l10n.ve.import.log</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="user_id"/>
                    <field name="import_type"/>
                    <field name="file_name"/>
                    <field name="total_rows"/>
                    <field name="success_count"/>
                    <field name="error_count"/>
                    <field name="skipped_count"/>
                </list>
            </field>
        </record>

        <!-- Log Form View -->
        <record id="view_l10n_ve_import_log_form" model="ir.ui.view">
            <field name="name">l10n.ve.import.log.form</field>
            <field name="model">l10n.ve.import.log</field>
            <field name="arch" type="xml">
                <form string="Log de Importación">
                    <sheet>
                        <group>
                            <field name="date" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="import_type" readonly="1"/>
                            <field name="file_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_rows" readonly="1"/>
                            <field name="success_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                            <field name="skipped_count" readonly="1"/>
                        </group>
                        <group string="Registros Afectados">
                            <field name="record_ids" widget="text" readonly="1"
                                   placeholder="JSON con IDs de registros creados/actualizados"/>
                        </group>
                        <group string="Adjunto">
                            <field name="attachment_id" widget="attachment" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Log Action -->
        <record id="action_l10n_ve_import_log" model="ir.actions.act_window">
            <field name="name">Logs de Importación</field>
            <field name="res_model">l10n.ve.import.log</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem id="menu_l10n_ve_import"
                  name="Importar desde Excel"
                  parent="menu_l10n_ve_compliance_root"
                  sequence="45"
                  action="action_l10n_ve_import_wizard"/>
    </data>
</odoo>
