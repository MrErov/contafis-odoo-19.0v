<odoo>
    <record id="view_l10n_ve_cartelera_evidence_wizard_form" model="ir.ui.view">
        <field name="name">l10n.ve.cartelera.evidence.wizard.form</field>
        <field name="model">l10n.ve.cartelera.evidence.wizard</field>
        <field name="arch" type="xml">
            <form string="Subir Evidencia">
                <sheet>
                    <group>
                        <field name="cartelera_status_id" invisible="1"/>
                        <field name="image" widget="image" class="oe_avatar"/>
                        <field name="filename" readonly="1"/>
                        <field name="file_size_mb" readonly="1"/>
                        <field name="notes"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Tamaño máximo: 5 MB. Las imágenes se comprimen automáticamente a 1024x1024.
                    </div>
                </sheet>
                <footer>
                    <button string="Subir" type="object" name="action_upload"
                            class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_ve_cartelera_evidence_wizard" model="ir.actions.act_window">
        <field name="name">Subir Evidencia</field>
        <field name="res_model">l10n.ve.cartelera.evidence.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_l10n_ve_cartelera_evidence_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_cartelera_status_id': active_id}</field>
    </record>
</odoo>